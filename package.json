{
  "name": "turnosala-prospector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm test",
    "e2e": "npm run build -w @turnosala/web && playwright test",
    "db:setup": "tsx scripts/db-setup.ts",
    "user:create": "tsx scripts/create-user.ts",
    "seed:product-facts": "tsx scripts/seed-product-facts.ts",
    "approve:product-facts": "tsx scripts/approve-product-facts.ts",
    "customers:import": "tsx scripts/import-customers.ts",
    "territories:import": "tsx scripts/import-territories.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "local:init": "tsx scripts/local.ts init",
    "local:up": "tsx scripts/local.ts up",
    "local:down": "tsx scripts/local.ts down",
    "local:logs": "tsx scripts/local.ts logs",
    "local:status": "tsx scripts/local.ts status",
    "local:ai-on": "tsx scripts/local.ts ai-on",
    "local:ai-off": "tsx scripts/local.ts ai-off",
    "local:maps-on": "tsx scripts/local.ts maps-on",
    "local:maps-off": "tsx scripts/local.ts maps-off",
    "local:reset": "tsx scripts/local.ts reset",
    "llm:check": "tsx scripts/llm-check.ts",
    "golden:snapshot": "tsx scripts/golden-snapshot.ts",
    "eval:extract": "tsx scripts/eval-extract.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
